# Server-only. Never use a VITE_ prefix for an API key.
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=flux-naveen-en
DEEPGRAM_TTS_SPEED=1
# Flux beta: -2 calm to 2 animated; 0 restores tuned delivery.
DEEPGRAM_TTS_EXPRESSIVITY=1
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=multi
# Deepgram-managed LLM; no separate model-provider key required.
DEEPGRAM_THINK_PROVIDER=open_ai
DEEPGRAM_THINK_MODEL=gpt-4o-mini
PORT=3000
HOST=127.0.0.1

# Lead delivery — server-only; fill these before deploying.
LEAD_EMAIL_TO=singhkrishna512@gmail.com
LEAD_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# HTTPS endpoint accepting {name, phone, email, requirement, message} as JSON.
CRM_WEBHOOK_URL=
# Optional Bearer credential for the CRM endpoint.
CRM_WEBHOOK_TOKEN=
# Private durable directory. Use a persistent volume in production.
LEADS_DATA_DIR=data/leads
